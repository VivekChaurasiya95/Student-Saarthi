# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change_me_to_a_secure_random_string_in_production

# Server Settings
HOST=0.0.0.0
PORT=5000

# Database Configuration
# Default is local SQLite in instance/database/
DATABASE_URL=sqlite:///instance/database/student_saarthi.db
# To use MySQL instead, set DATABASE_URL=mysql+mysqlconnector://root:password@localhost/student_saarthi

# MySQL Settings (fallback / legacy)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=student_saarthi

# File Uploads
UPLOAD_FOLDER=static/documents/uploads
MAX_CONTENT_LENGTH=16777216

# Google OAuth
GOOGLE_CLIENT_ID=1080666056729-ameupnthncvtjko6lgo2u0237n46ggq7.apps.googleusercontent.com

